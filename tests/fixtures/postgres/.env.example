# Disposable localhost fixture values. Do not reuse outside local development.
DFE_PG_ADMIN_PASSWORD=local-dfe-admin
DFE_PG_READER_PASSWORD=local-dfe-reader
DFE_PG_WRITER_PASSWORD=local-dfe-writer
DFE_PG_METADATA_MIGRATOR_PASSWORD=local-dfe-metadata-migrator
DFE_PG_METADATA_WRITER_PASSWORD=local-dfe-metadata-writer
DFE_PG_METADATA_READER_PASSWORD=local-dfe-metadata-reader
DFE_PG_PORT=55432
DFE_TEST_POSTGRES_ADMIN_DSN="host=127.0.0.1 port=55432 dbname=postgres user=postgres password=local-dfe-admin sslmode=disable"
DFE_TEST_POSTGRES_READER_DSN="host=127.0.0.1 port=55432 dbname=dfe_fixture user=dfe_fixture_reader password=local-dfe-reader sslmode=disable"
DFE_TEST_POSTGRES_WRITER_DSN="host=127.0.0.1 port=55432 dbname=dfe_fixture user=dfe_fixture_writer password=local-dfe-writer sslmode=disable"
DFE_TEST_POSTGRES_METADATA_MIGRATOR_DSN="host=127.0.0.1 port=55432 dbname=dfe_fixture user=dfe_metadata_migrator_login password=local-dfe-metadata-migrator sslmode=disable"
DFE_TEST_POSTGRES_METADATA_WRITER_DSN="host=127.0.0.1 port=55432 dbname=dfe_fixture user=dfe_metadata_writer_login password=local-dfe-metadata-writer sslmode=disable"
DFE_TEST_POSTGRES_METADATA_READER_DSN="host=127.0.0.1 port=55432 dbname=dfe_fixture user=dfe_metadata_reader_login password=local-dfe-metadata-reader sslmode=disable"
